    "unique",
    "uniqueBy",
    "prototype"
  ],
  "homepage": "https://github.com/mdgfox/array-extensions#readme",
  "bugs": {
    "url": "https://github.com/mdgfox/array-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdgfox/array-extensions.git"
  },
  "license": "MIT",
  "author": "Alex Khmelev <alex.khmelev.dev@gmail.com> (https://github.com/mdgfox)",
